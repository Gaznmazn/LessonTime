  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background-color: #121212;
}

QLabel {
    color: #E0E0E0;
    font-family: 'Segoe UI', 'Arial', sans-serif;
}

QFrame#taskZone {
    background-color: #1E1E1E;
    border-radius: 12px;
}

QLineEdit#textTask {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    padding: 4px 6px;
    color: #E0E0E0;
    font-size: 13px;
}

QLineEdit#textTask:focus {
    border: 1px solid #3B82F6;
}

QPushButton#addBtnTask {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 8px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#addBtnTask:hover {
    background-color: #45a049;
}

QPushButton#addBtnTask:pressed {
    background-color: #3e8e41;
}

/* Список задач (если используешь QListWidget) */
QListWidget#taskList {
    background-color: transparent;
    border: none;
    color: #E0E0E0;
    font-size: 14px;
}

QListWidget#taskList::item {
    padding: 12px;
    border-radius: 6px;
    margin: 4px 0;
}

QListWidget#taskList::item:selected {
    background-color: #2D2D30;
    border-left: 3px solid #4CAF50;
}

QListWidget#taskList::item:hover {
    background-color: #2A2A2D;
}


QFrame#mainZone {
    background-color: #252526;
    border-radius: 12px;
	padding: 2px
}

/* Заголовок сессии */
QLabel#focusZone {
    color: #B0B0B0;
    font-size: 14pt;
    font-weight: normal;
    qproperty-alignment: AlignCenter;
}

/* Цифры таймера */
QLabel#timerZone {
    color: #FFFFFF;
    font-family: 'Consolas', 'Courier New', 'Roboto Mono', monospace;
    font-size: 82pt;
    font-weight: normal;
    qproperty-alignment: AlignCenter;
}

/* Прогресс-бар */
QProgressBar#progressZone {
    height: 8px;
    border-radius: 4px;
    background-color: #333333;
    text-align: center;
    color: transparent;

}

QProgressBar::chunk#progressZone {
    background-color: #4CAF50;
    border-radius: 4px;
}

/* Переключатели режимов */
QFrame#modeZone {
    background-color: transparent;
    margin: 16px 0;
}

QPushButton#fiveOneMode,
QPushButton#fourOneMode,
QPushButton#Custom {
    background-color: transparent;
    color: #888888;
    border: 2px solid #3E3E42;
    border-radius: 12px;
    padding: 4px 20px;
    font-size: 12px;
    font-weight: normal;
}

QPushButton#fiveOneMode:hover,
QPushButton#fourOneMode:hover,
QPushButton#Custom:hover {
    color: #E0E0E0;
    border-color: #5A5A5E;
}

QPushButton#fiveOneMode:checked,
QPushButton#fourOneMode:checked,
QPushButton#Custom:checked {
    background-color: #4CAF50;
    color: white;
    border-color: #4CAF50;
}

/* Кнопки управления */
QFrame#frame {
    background-color: transparent;
    margin-top: 16px;
}

QPushButton#startBtn {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 6px;
    font-size: 14pt;
    font-weight: bold;
}

QPushButton#startBtn:hover {
    background-color: #45a049;
}

QPushButton#startBtn:pressed {
    background-color: #3e8e41;
}

QPushButton#pauseBtn {
    background-color: #FF9800;
    color: #1E1E1E;
    border: none;
    border-radius: 12px;
    padding: 14px 4px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#pauseBtn:hover {
    background-color: #F57C00;
}

QPushButton#pauseBtn:pressed {
    background-color: #E65100;
}

QPushButton#resetBtn {
    background-color: #EF4444;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 4px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#resetBtn:hover {
    background-color: #DC2626;
}

QPushButton#resetBtn:pressed {
    background-color: #B91C1C;
}

/* ========================================
   ЗОНА В - ПРАВАЯ ПАНЕЛЬ (АНАЛИТИКА)
   ======================================== */

QFrame#analyzeZone {
    background-color: #1E1E1E;
    border-radius: 12px;
}

/* Карточки статистики */
QFrame#todayZone,
QFrame#streakZone,
QFrame#sessionsZone,
QFrame#weekStreak {
    background-color: #252526;
    border-radius: 8px;
    margin-bottom: 6px;
}

/* Подписи (Today:, Streak:, Sessions:, This week:) */
QLabel#todayTag,
QLabel#sessionTag,
QLabel#streakTag,
QLabel#weekTag {
    color: #E0E0E0;
    font-size: 10pt;
}

/* Значения (3h 20m, 5 days, 8, 18h 45m) */
QLabel#todayStat,
QLabel#sessionStat,
QLabel#streakStat,
QLabel#weekStat {
	color: #4CAF50;
    font-size: 18pt;
    font-weight: bold;
	margin-bottom: 4px;
}

QFrame#weekStreak QLabel#weekStat,
QFrame#streakZone QLabel#streakStat {
    color: #3B82F6;
}


/* Дни недели (полоски графика) */
QFrame#dayOne,
QFrame#dayTwo,
QFrame#dayThree,
QFrame#dayFour,
QFrame#dayFive,
QFrame#daySix,
QFrame#daySeven {
    background-color: #3E3E42;
    border-radius: 4px;
    min-width: 12px;
    max-width: 12px;
}

/* Активный день (сегодня) */
/*QFrame#dayOne {
    background-color: #4CAF50;
}*/ </string>
